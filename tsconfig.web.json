{
  "compilerOptions": {
    "baseUrl": ".",
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "jsx": "preserve",
    "paths": {
      "@renderer/*": ["./src/renderer/src/*"],
      "@shared/*": ["./shared/*"],
      "@resources/*": ["./resources/*"]
    }
  },
  "include": ["src/renderer/**/*.ts", "src/renderer/**/*.tsx", "src/renderer/**/*.vue", "shared/**/*.ts", "src/renderer/**/*.d.ts"]
}
